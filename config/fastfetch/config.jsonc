{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ": ",
    "percent": {
      "type": 2
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS              ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "Kernel          ",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "DE              ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "WM              ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "Shell           ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "Terminal        ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "Packages        ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Uptime          ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "display",
      "key": "Display         ",
      "keyColor": "magenta"
    },
    {
      "type": "host",
      "key": "Host            ",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "CPU             ",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "GPU             ",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "Memory          ",
      "keyColor": "magenta",
      "shell": "/bin/bash",
      "text": "export LC_ALL=C; read -r u t p <<< $(free -m | awk 'NR==2 {if($2>0) printf \"%.2f %.2f %d\", $3/1024, $2/1024, ($3/$2)*100; else print \"0.00 0.00 0\"}'); b='[ '; for((i=0;i<10;i++)); do [ $i -lt $((p/10)) ] && b+='\\e[1;32m❙\\e[0m' || b+='-'; done; b+=' ]'; echo -e \"$b \\e[1;32m${p}%\\e[0m $u GiB / $t GiB\""
    },
    {
      "type": "command",
      "key": "Swap            ",
      "keyColor": "magenta",
      "shell": "/bin/bash",
      "text": "export LC_ALL=C; read -r u t p <<< $(free -m | awk 'NR==3 {if($2>0) printf \"%.2f %.2f %d\", $3/1024, $2/1024, ($3/$2)*100; else print \"0.00 0.00 0\"}'); b='[ '; for((i=0;i<10;i++)); do [ $i -lt $((p/10)) ] && b+='\\e[1;32m❙\\e[0m' || b+='-'; done; b+=' ]'; echo -e \"$b \\e[1;32m${p}%\\e[0m $u GiB / $t GiB\""
    },
    "break",
    {
      "type": "command",
      "key": "             ",
      "shell": "/bin/bash",
      "text": "C=43; P=45; out=\"\"; for d in $(lsblk -ndpo NAME | grep -vE 'loop|ram|sr|fd|nbd'); do m=$(lsblk -ndpo MODEL \"$d\" 2>/dev/null | xargs); [ -z \"$m\" ] && m=$(basename \"$d\"); parts=$(lsblk -lnpo NAME,SIZE,FSUSE%,FSUSED,MOUNTPOINT \"$d\" | awk '$5 ~ \"^/\"'); if [ -n \"$parts\" ]; then out+=\"\\r\\e[${C}G\\e[1;36m${m}\\e[0m\\e[K\\n\"; while read -r devname size perc used mp; do u=${perc//%/}; [ -z \"$u\" ] && u=0; p=$((u/10)); b='[ '; for((i=0;i<10;i++)); do [ $i -lt $p ] && b+='\\e[1;32m❙\\e[0m' || b+='-'; done; b+=' ]'; fstype=$(findmnt -rn -o FSTYPE \"$devname\" 2>/dev/null | head -n1); [ -z \"$fstype\" ] && fstype=\"unknown\"; if findmnt -rn -o TARGET \"$devname\" 2>/dev/null | grep -Fxq \"/\"; then s_mp=\"/\"; elif [ \"$mp\" = \"/\" ]; then s_mp=\"/\"; else s_mp=\"/$(basename \"$mp\")\"; fi; printf -v line \"\\r\\e[${P}G%-14s: %b \\e[1;32m%s\\e[0m %s / %s - %s\\e[K\\n\" \"($s_mp)\" \"$b\" \"$perc\" \"$used\" \"$size\" \"$fstype\"; out+=\"$line\"; done <<< \"$parts\"; fi; done; echo -ne \"${out%\\n}\""
    },
    "break",
    {
      "type": "command",
      "key": "LAN             ",
      "keyColor": "blue",
      "shell": "/bin/bash",
      "text": "ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^(en|eth)/ {sub(/\\/.*/, \"\", $4); print $4; exit}' | grep . || echo 'Disconnected'"
    },
    {
      "type": "command",
      "key": "Wifi            ",
      "keyColor": "blue",
      "shell": "/bin/bash",
      "text": "ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^wl/ {sub(/\\/.*/, \"\", $4); print $4; exit}' | grep . || echo 'Disconnected'"
    },
    {
      "type": "command",
      "key": "Tailscale       ",
      "keyColor": "blue",
      "shell": "/bin/bash",
      "text": "ip -4 -o addr show tailscale0 2>/dev/null | awk '{sub(/\\/.*/, \"\", $4); print $4; exit}' | grep . || echo 'Disconnected'"
    },
    "break"
  ]
}
